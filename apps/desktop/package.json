{
  "name": "my-harness-desktop",
  "version": "0.2.3",
  "productName": "Y Harness",
  "private": true,
  "description": "Y Harness desktop client (Electron + React, speaks the my-harness WS protocol)",
  "author": "my-harness",
  "main": "main.cjs",
  "scripts": {
    "bundle": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "pack": "node build.mjs && node prepkg.cjs && node pack-fast.cjs",
    "dist": "node build.mjs && node prepkg.cjs && electron-builder --win",
    "dist:fast": "node build.mjs && node prepkg.cjs && electron-builder --win dir -c.compression=store"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "playwright": "^1.63.0",
    "rcedit": "^5.0.1",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.myharness.desktop",
    "productName": "Y Harness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/index.html",
      "renderer/bundle.js",
      "renderer/bundle.css",
      "renderer/chunk-*.js",
      "renderer/chunk-*.css",
      "renderer/monaco-*.worker.js",
      "renderer/codicon-*.ttf",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "extraResources": [
      {
        "from": "build/harness-server",
        "to": "harness-server"
      },
      {
        "from": "build/rg",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
