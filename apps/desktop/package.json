{
  "name": "my-harness-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "My-Harness desktop client (Electron + React, speaks the my-harness WS protocol)",
  "author": "my-harness",
  "main": "main.cjs",
  "scripts": {
    "bundle": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "dist": "node build.mjs && node prepkg.cjs && electron-builder --win"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.myharness.desktop",
    "productName": "My-Harness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "renderer/index.html",
      "renderer/bundle.js"
    ],
    "extraResources": [
      {
        "from": "build/harness-server.exe",
        "to": "harness-server.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
