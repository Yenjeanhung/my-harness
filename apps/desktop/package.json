{
  "name": "my-harness-desktop",
  "version": "0.2.1",
  "productName": "Y Harness",
  "private": true,
  "description": "Y Harness desktop client (Electron + React, speaks the my-harness WS protocol)",
  "author": "my-harness",
  "main": "main.cjs",
  "scripts": {
    "bundle": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "pack": "node build.mjs && node prepkg.cjs && node pack-fast.cjs",
    "dist": "node build.mjs && node prepkg.cjs && electron-builder --win",
    "dist:fast": "node build.mjs && node prepkg.cjs && electron-builder --win dir -c.compression=store"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "playwright": "^1.63.0",
    "rcedit": "^5.0.1",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.myharness.desktop",
    "productName": "Y Harness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/index.html",
      "renderer/bundle.js",
      "renderer/bundle.css",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "extraResources": [
      {
        "from": "build/harness-server.exe",
        "to": "harness-server.exe"
      },
      {
        "from": "build/rg",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
